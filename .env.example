# Copy to .env.local for local dev. Local values come from `supabase status -o env`.
# Prod (`npm run ios:prod`): put the three EXPO_PUBLIC_ values for the live Supabase and server in .env.production.local.
# Server only (never EXPO_PUBLIC_): full database access.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Direct Postgres for the server's transactions. Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: the direct connection or either pooler (the server doesn't use prepared statements).
DATABASE_URL=
# Phones: read-only through RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The command server (`npm run server`). On a phone, use the laptop's LAN or Tailscale address.
EXPO_PUBLIC_SERVER_URL=http://127.0.0.1:8787
# The server requires at least one real configured model. Default chat and typed decisions use
# OpenAI gpt-6-luna; speech uses gpt-4o-mini-transcribe / gpt-4o-mini-tts. Server only.
OPENAI_API_KEY=
# MODEL_PROVIDER=spark tries Spark first for decisions and text to speech (/v1/systemone, qwen3-tts),
# then falls back to OpenAI when it fails or runs late. Default structured chat and transcription stay on OpenAI;
# an explicit LLM_* chat override or ASR_PROVIDER transcription override below is independent.
# MODEL_PROVIDER=spark
SPARK_API_KEY=
SPARK_BASE_URL=https://distinguished-directory-infrastructure-wife.trycloudflare.com/v1
# Explicit structured-chat override (for example, Mobilization with medium reasoning).
# Existing private LLM_* settings continue to work; tools/decisions/speech keep their own shared OpenAI defaults.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=<your OpenAI API key>
# LLM_MODEL=gpt-6-luna
# LLM_REASONING_EFFORT=medium
# Mobilization uses /responses with one read-only get_playbooks round, then strict final JSON.
# Its configured endpoint must support Responses reasoning/tools; other model workloads are unchanged.
# Optional Mobilization-only overrides. Model and tier inherit the structured-chat model and
# provider/project tier policy when omitted. Reasoning defaults explicitly to medium, independently
# of LLM_REASONING_EFFORT. Explicit blank or invalid values fail closed instead of falling back.
# These never alter intake tools, other structured chat, typed decisions or speech models.
# MOBILIZATION_MODEL=gpt-6-sol
# MOBILIZATION_SERVICE_TIER=fast
# MOBILIZATION_REASONING_EFFORT=low
# Mobilization reasoning accepts only medium or low. This setting is scoped to Mobilization;
# keep medium unless low has passed the same quality checks. It does not change other AI workloads.
# Tier accepts only default or fast. Fast is a paid opt-in, not a guaranteed latency bound;
# audits distinguish the requested tier from the provider's actual service_tier response.
# Mobilization only: 180 seconds by default (integer 60000–300000 ms).
# Whole-call deadline adds 30 seconds; interrupted-run expiry adds 60 seconds.
# This does not change the shorter intake, decisions or speech deadlines.
# MOBILIZATION_MODEL_TIMEOUT_MS=180000
# Legacy Spark TYPESAFE_BASE_URL (without /v1), TYPESAFE_API_KEY and OPENROUTER_API_KEY remain compatibility aliases.
# Spark allows 4 calls at once and 100 a minute per key; use the organizer's current limits.
# SPARK_CONCURRENCY=3
# SPARK_RPM=95
# A volunteer's "Heard: ..." waits this long for the classifier before keywords stand in.
# AI_INTERPRET_MS=1500
# Speech (phase 4): the pill's clips are transcribed, and spoken briefs rendered, by the same provider as the rest.
# SPEECH_BASE_URL puts another OpenAI-shaped server first for text to speech, OpenAI behind it,
# e.g. the same Qwen3 models on this Mac: `uv tool install "mlx-audio[server,stt,tts]"`, then `mlx_audio.server --port 8790`.
# SPEECH_BASE_URL=http://127.0.0.1:8790/v1
# SPEECH_API_KEY=
# Model and voice overrides for the Spark or SPEECH_BASE_URL. Spark: qwen3-asr-1.7b, qwen3-tts, `jarvis` (or any
# described voice). Local: mlx-community/Qwen3-ASR-1.7B-8bit, mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-6bit, `ryan`.
# Transcription is OpenAI (gpt-4o-mini-transcribe). ASR_PROVIDER=qwen sends it to the Spark / SPEECH_BASE_URL first instead.
# ASR_PROVIDER=
# ASR_MODEL=
# TTS_MODEL=
# TTS_VOICE=

# Server, optional.
# PORT=8787
# Scheduler pass interval; 0 turns it off.
# SCHEDULER_MS=5000
# Lifecycle timings (src/lib/lifecycle.ts). POLICY_SCALE multiplies all of them; the rest set one each, in ms.
# check-commands runs its own scoped scheduler against: POLICY_SCALE=0.05 POLICY_AUTO_ASSIGN_MS=3000 SCHEDULER_MS=0
# POLICY_SCALE=1
# POLICY_ACK_TIMEOUT_MS=
# POLICY_NUDGE_GAP_MS=
# POLICY_AUTO_ASSIGN_MS=

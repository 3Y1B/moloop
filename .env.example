# Copy to .env.local. Local values come from `supabase status -o env`.
# Server only (never EXPO_PUBLIC_): full database access.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Phones: read-only through RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
USE_LIVE_MODELS=0
JEV_API_URL=
JEV_API_KEY=
LLM_MODEL=gpt-6-luna

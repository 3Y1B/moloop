# Copy to .env.local. Local values come from `supabase status -o env`.
# Server only (never EXPO_PUBLIC_): full database access.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Direct Postgres for the server's transactions. Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: the direct connection or either pooler (the server doesn't use prepared statements).
DATABASE_URL=
# Phones: read-only through RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Which backend the app runs on: `supabase` for the shared world (sign-in, realtime, server commands).
# Anything else, or unset, keeps the in-memory mock with its demo controls.
EXPO_PUBLIC_REPO=
# The command server (`npm run server`). On a phone, use the laptop's LAN or Tailscale address.
EXPO_PUBLIC_SERVER_URL=http://127.0.0.1:8787
# Models. 1 puts Spark (and Luna) behind every decision; anything else keeps the keyword stand-ins.
USE_LIVE_MODELS=0
# Spark: typed decisions (/v1/systemone), chat, speech. Server only.
TYPESAFE_BASE_URL=
TYPESAFE_API_KEY=
# Set this and chat moves to GPT-6 Luna on OpenRouter (typed decisions stay on Spark).
OPENROUTER_API_KEY=
# Chat overrides. Defaults: qwen3.5:4b on Spark; openai/gpt-6-luna with OpenRouter.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_REASONING_EFFORT=
# Spark allows 4 calls at once and 30 a minute per key; these stay under that.
# SPARK_CONCURRENCY=3
# SPARK_RPM=28
# A volunteer's "Heard: ..." waits this long for the classifier before keywords answer.
# AI_INTERPRET_MS=1500

# Server, optional.
# PORT=8787
# Scheduler pass interval; 0 turns it off.
# SCHEDULER_MS=5000
# Lifecycle timings (src/lib/lifecycle.ts). POLICY_SCALE multiplies all of them; the rest set one each, in ms.
# check-commands runs against: POLICY_SCALE=0.05 POLICY_AUTO_ASSIGN_MS=3000 SCHEDULER_MS=500
# POLICY_SCALE=1
# POLICY_ACK_TIMEOUT_MS=
# POLICY_NUDGE_GAP_MS=
# POLICY_AUTO_ASSIGN_MS=

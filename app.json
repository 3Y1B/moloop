{
  "expo": {
    "name": "moloop",
    "slug": "moloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moloop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.moloop",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Moloop uses Bluetooth to help you and your volunteer find each other in the crowd."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6BF5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.moloop"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F6BF5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Moloop listens while you hold the talk button.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Moloop shows where you are on the festival map and shares it with whoever is coming to help.",
          "locationAlwaysAndWhenInUsePermission": "On duty, Moloop shares where you are with your lead, even with the phone in your pocket.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55b6cb19-2e5b-4a90-824f-3eedc1ee3bc5"
      }
    }
  }
}
